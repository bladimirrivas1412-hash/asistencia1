#.evn.example
#1. Copis este archivo y renombralo a .evn (sin example)
#2. Llena los archivos de Tu equipo
#3.El archivo .env Nunca de sube a github
 
#Llave para firmar la cecion. Pon una frase larga y diferente por equipo

SECRET_KEY=cambia-esta-frase-por-una-larga-y-secreta

#1 = modo desarrollo (errores detallados y ruta /dev/entrar/). En Render va 0

modo_DESARROLLO=1

# ---BASE DE DATOS ---
#Opcion A: XAMPP local -> DB_HOST=Localhost DB_PORT=3306 DB_USER= root DB_PASSWORT= (vasio)
#Option B: Los datos del "conection information" del servicio

DB_HOST=Localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORT=
#Cada equipo tiene la sulla 

DB_NAME=asist_e4
#Solo para Aiven: ruta al archivo ca.pem que que se descarga en el archivo .

DB_SSL_CA=
#--- Clave que manda el ESP32 en el encabezado x-Dispositivo ---
CLAVE_DISPOSITIVO=clave-de-prueva-ESP32